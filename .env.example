# -------------------------------------------------------------
# KAAMSETU — ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (JWT)
JWT_SECRET=kaamsetu_super_secure_jwt_secret_dev_2026_change_in_production
JWT_EXPIRES_IN=7d

# Database (PostgreSQL with PostGIS support)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kaamsetu?schema=public

# Optional: Managed Redis URL for realtime pub/sub in multi-instance scale
REDIS_URL=redis://localhost:6379

# SMS OTP Provider (e.g. Fast2SMS / MSG91 / Twilio)
# In development, default test OTP 123456 is supported for instant verification
OTP_PROVIDER=simulator
OTP_PROVIDER_API_KEY=your_otp_provider_api_key_here
OTP_SENDER_ID=KAAMST

# Google Maps Platform (JavaScript API, Places, Geocoding, Routes)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_MAP_ID=your_google_maps_map_id_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Payment Gateway (Razorpay / Stripe marketplace integration)
PAYMENT_PROVIDER=razorpay_test
PAYMENT_PROVIDER_KEY=rzp_test_kaamsetu_dummy_key
PAYMENT_PROVIDER_SECRET=your_payment_provider_secret_here
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_here

# Firebase Cloud Messaging (Push notifications)
FIREBASE_PROJECT_ID=kaamsetu-notifications
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@kaamsetu-notifications.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Cloud Storage (Worker KYC ID documents, before/after job photos)
CLOUDINARY_URL=cloudinary://api_key:api_secret@kaamsetu_cloud
# Or Private S3 Compatible:
# S3_BUCKET=kaamsetu-private-docs
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...

# Platform Business Configuration
PLATFORM_COMMISSION_PERCENTAGE=10
DEFAULT_SEARCH_RADIUS_KM=15
