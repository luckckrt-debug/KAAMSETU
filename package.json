{
  "name": "kaamsetu",
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.4",
  "private": true,
  "description": "KAAMSETU - Production-oriented Indian Workforce Marketplace Platform",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node server.js",
    "dev:next": "next dev",
    "build": "next build",
    "start": "NODE_ENV=production node server.js",
    "api": "node services/api/dist/index.js",
    "worker": "pnpm --filter @kaamsetu/worker start",
    "hiring": "pnpm --filter @kaamsetu/hiring start",
    "contractor": "pnpm --filter @kaamsetu/contractor start",
    "test:mobile-sync": "node scripts/test-cross-app-sync.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node scripts/seed.js",
    "test": "node scripts/run-tests.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@prisma/client": "^5.22.0",
    "@types/leaflet": "^1.9.22",
    "bcryptjs": "^2.4.3",
    "firebase": "^10.13.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.11.0",
    "next": "^14.2.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2"
  },
  "optionalDependencies": {
    "@next/swc-wasm-nodejs": "^14.2.33"
  }
}