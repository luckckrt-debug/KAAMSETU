// Prisma Schema for KAAMSETU - Indian Digital Workforce Marketplace
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRoleType {
  CUSTOMER
  WORKER
  CONTRACTOR
  TENDER_OWNER
  TEAM_LEADER
  ADMIN
  SUPER_ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  REQUESTED
  OFFERED
  ACCEPTED
  WORKER_ON_THE_WAY
  ARRIVED
  WORK_STARTED
  WORK_COMPLETED
  CUSTOMER_CONFIRMED
  PAYMENT_PENDING
  PAYMENT_PROCESSING
  PAYMENT_PAID
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  INITIATED
  PENDING
  AUTHORIZED
  PROCESSING
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
  CANCELLED
}

enum TenderStatus {
  DRAFT
  PUBLISHED
  APPLICATIONS_OPEN
  SHORTLISTING
  AWARDED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum TenderApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  SELECTED
  REJECTED
  WITHDRAWN
}

enum DisputeStatus {
  OPEN
  UNDER_INVESTIGATION
  RESOLVED_REFUND
  RESOLVED_DISMISSED
  RESOLVED_PARTIAL_REFUND
}

enum DisputeReason {
  WORKER_NO_SHOW
  POOR_QUALITY
  OVERCHARGING
  UNPROFESSIONAL_BEHAVIOUR
  INCOMPLETE_WORK
  PROPERTY_DAMAGE
  OTHER
}

// -------------------------------------------------------------
// USERS & ROLES
// -------------------------------------------------------------

model User {
  id              String         @id @default(uuid())
  phoneNumber     String         @unique
  phoneVerified   Boolean        @default(false)
  email           String?        @unique
  fullName        String
  avatarUrl       String?
  language        String         @default("hi") // 'hi', 'en', etc.
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  roles           UserRole[]
  workerProfile   WorkerProfile?
  customerProfile CustomerProfile?
  contractorProfile ContractorProfile?
  adminUser       AdminUser?

  notifications   Notification[]
  auditLogs       AuditLog[]
  chatMessages    ChatMessage[]

  @@index([phoneNumber])
}

model UserRole {
  id        String       @id @default(uuid())
  userId    String
  role      UserRoleType
  createdAt DateTime     @default(now())

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

// -------------------------------------------------------------
// WORKER SYSTEM
// -------------------------------------------------------------

model WorkerProfile {
  id                String             @id @default(uuid())
  userId            String             @unique
  headline          String?
  bio               String?
  yearsExperience   Int                @default(0)
  hourlyRate        Float?
  dailyRate         Float?
  contractRate      Float?
  toolsAvailable    String?            // Comma-separated or JSON
  qualification     String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  rejectionReason   String?
  isOnline          Boolean            @default(false)
  isAvailableNow    Boolean            @default(true)
  emergencyAvailable Boolean           @default(false)
  ratingAvg         Float              @default(5.0)
  ratingCount       Int                @default(0)
  completedJobsCount Int               @default(0)

  // Location details
  state             String?
  city              String?
  district          String?
  pincode           String?
  locality          String?
  address           String?
  latitude          Float?
  longitude         Float?
  preferredRadiusKm Float              @default(15.0)

  // Bank & UPI Payout
  upiId             String?
  bankAccountNumber String?
  bankIfsc          String?
  bankAccountName   String?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills            WorkerSkill[]
  locations         WorkerLocation[]
  availability      WorkerAvailability?
  documents         WorkerDocument[]
  verifications     WorkerVerification[]
  bookingAssignments BookingAssignment[]
  reviews           JobReview[]        @relation("WorkerReviews")
  payouts           WorkerPayout[]
  tenderApplications TenderApplication[]
  teamMemberships   TenderTeamMember[]

  @@index([city, verificationStatus])
  @@index([latitude, longitude])
  @@index([isOnline, isAvailableNow])
}

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  nameHi        String?       // Hindi title
  slug          String        @unique
  iconName      String?
  description   String?
  displayOrder  Int           @default(0)
  isActive      Boolean       @default(true)

  subcategories Subcategory[]
  workerSkills  WorkerSkill[]
  tenders       Tender[]
}

model Subcategory {
  id          String        @id @default(uuid())
  categoryId  String
  name        String
  nameHi      String?
  slug        String        @unique
  description String?

  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  skills      WorkerSkill[]

  @@index([categoryId])
}

model WorkerSkill {
  id             String        @id @default(uuid())
  workerProfileId String
  categoryId     String
  subcategoryId  String?
  experienceYears Int          @default(1)
  isPrimary      Boolean       @default(false)

  workerProfile  WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  category       Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory    Subcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  @@unique([workerProfileId, categoryId, subcategoryId])
  @@index([workerProfileId])
  @@index([categoryId])
}

model ServiceArea {
  id          String   @id @default(uuid())
  state       String
  city        String
  district    String
  pincode     String
  locality    String
  latitude    Float
  longitude   Float
  isActive    Boolean  @default(true)

  @@index([pincode])
  @@index([city])
}

model WorkerLocation {
  id              String        @id @default(uuid())
  workerProfileId String
  latitude        Float
  longitude       Float
  accuracyMeters  Float?
  heading         Float?
  speed           Float?
  timestamp       DateTime      @default(now())

  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([workerProfileId, timestamp])
}

model WorkerAvailability {
  id              String        @id @default(uuid())
  workerProfileId String        @unique
  mondayHours     String        @default("09:00-18:00")
  tuesdayHours    String        @default("09:00-18:00")
  wednesdayHours  String        @default("09:00-18:00")
  thursdayHours   String        @default("09:00-18:00")
  fridayHours     String        @default("09:00-18:00")
  saturdayHours   String        @default("09:00-18:00")
  sundayHours     String        @default("OFF")

  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
}

model WorkerDocument {
  id              String             @id @default(uuid())
  workerProfileId String
  docType         String             // 'AADHAAR', 'VOTER_ID', 'PAN', 'TRADE_CERTIFICATE', 'POLICE_VERIFICATION'
  docNumber       String?            // Encrypted/masked
  fileUrl         String
  status          VerificationStatus @default(SUBMITTED)
  adminNotes      String?
  uploadedAt      DateTime           @default(now())
  reviewedAt      DateTime?

  workerProfile   WorkerProfile      @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([workerProfileId])
  @@index([status])
}

model WorkerVerification {
  id              String             @id @default(uuid())
  workerProfileId String
  reviewerId      String?
  previousStatus  VerificationStatus
  newStatus       VerificationStatus
  reason          String?
  reviewedAt      DateTime           @default(now())

  workerProfile   WorkerProfile      @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([workerProfileId])
}

// -------------------------------------------------------------
// CUSTOMER & CONTRACTOR PROFILES
// -------------------------------------------------------------

model CustomerProfile {
  id            String            @id @default(uuid())
  userId        String            @unique
  addressLine   String?
  city          String?
  state         String?
  pincode       String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses     CustomerAddress[]
  bookings      Booking[]
  reviews       JobReview[]       @relation("CustomerReviews")
  disputes      JobDispute[]
}

model CustomerAddress {
  id                String          @id @default(uuid())
  customerProfileId String
  label             String          @default("Home") // Home, Work, Site
  addressLine       String
  landmark          String?
  locality          String?
  city              String
  state             String
  pincode           String
  latitude          Float
  longitude         Float
  isDefault         Boolean         @default(false)

  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([customerProfileId])
}

model ContractorProfile {
  id            String             @id @default(uuid())
  userId        String             @unique
  companyName   String
  gstin         String?
  panNumber     String?
  businessType  String             // 'CIVIL_CONSTRUCTION', 'ELECTRICAL_CONTRACTS', 'MANPOWER_AGENCY'
  city          String
  state         String
  verification  VerificationStatus @default(SUBMITTED)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenders       Tender[]
  teamsLed      TenderTeam[]       @relation("ContractorTeams")
}

// -------------------------------------------------------------
// TENDER & BULK WORKFORCE MARKETPLACE
// -------------------------------------------------------------

model Tender {
  id                  String             @id @default(uuid())
  contractorProfileId String
  categoryId          String
  title               String
  projectName         String
  description         String
  locationAddress     String
  city                String
  state               String
  pincode             String
  siteLatitude        Float
  siteLongitude       Float
  workerCountRequired Int
  skillsRequired      String             // Comma-separated or JSON
  experienceRequired  Int                @default(1)
  startDate           DateTime
  endDate             DateTime
  workingHours        String             @default("8 Hours")
  shifts              String             @default("Day Shift")
  totalBudget         Float
  perWorkerRate       Float
  paymentTerms        String             @default("Weekly milestone payout")
  accommodationProvided Boolean          @default(false)
  foodProvided        Boolean            @default(false)
  transportProvided   Boolean            @default(false)
  safetyRequirements  String?
  applicationDeadline DateTime
  status              TenderStatus       @default(PUBLISHED)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  contractorProfile   ContractorProfile  @relation(fields: [contractorProfileId], references: [id], onDelete: Cascade)
  category            Category           @relation(fields: [categoryId], references: [id])
  applications        TenderApplication[]
  contracts           Contract[]

  @@index([city, status])
  @@index([categoryId])
}

model TenderApplication {
  id              String                  @id @default(uuid())
  tenderId        String
  workerProfileId String?
  tenderTeamId    String?
  proposedRate    Float
  proposedWorkersCount Int               @default(1)
  coverNote       String?
  status          TenderApplicationStatus @default(APPLIED)
  appliedAt       DateTime                @default(now())
  reviewedAt      DateTime?

  tender          Tender                  @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  workerProfile   WorkerProfile?          @relation(fields: [workerProfileId], references: [id], onDelete: SetNull)
  tenderTeam      TenderTeam?             @relation(fields: [tenderTeamId], references: [id], onDelete: SetNull)

  @@index([tenderId])
  @@index([workerProfileId])
  @@index([tenderTeamId])
}

model TenderTeam {
  id                  String              @id @default(uuid())
  leaderWorkerProfileId String
  contractorProfileId String?
  name                String
  primaryTrade        String
  description         String?
  createdAt           DateTime            @default(now())

  contractorProfile   ContractorProfile?  @relation("ContractorTeams", fields: [contractorProfileId], references: [id], onDelete: SetNull)
  members             TenderTeamMember[]
  applications        TenderApplication[]

  @@index([leaderWorkerProfileId])
}

model TenderTeamMember {
  id              String        @id @default(uuid())
  tenderTeamId    String
  workerProfileId String
  roleInTeam      String        @default("WORKER") // 'LEADER', 'ASSISTANT', 'SPECIALIST'
  joinedAt        DateTime      @default(now())

  tenderTeam      TenderTeam    @relation(fields: [tenderTeamId], references: [id], onDelete: Cascade)
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([tenderTeamId, workerProfileId])
}

model Contract {
  id                  String             @id @default(uuid())
  tenderId            String
  totalWorkers        Int
  agreedAmount        Float
  status              String             @default("ACTIVE") // ACTIVE, COMPLETED, TERMINATED
  signedAt            DateTime           @default(now())

  tender              Tender             @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  attendances         Attendance[]
  milestones          ProjectMilestone[]
}

model Attendance {
  id          String   @id @default(uuid())
  contractId  String
  workerId    String
  workDate    DateTime
  isPresent   Boolean  @default(true)
  shiftHours  Float    @default(8.0)
  recordedAt  DateTime @default(now())

  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, workerId, workDate])
}

model ProjectMilestone {
  id          String   @id @default(uuid())
  contractId  String
  title       String
  amount      Float
  isCompleted Boolean  @default(false)
  completedAt DateTime?

  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// BOOKING ENGINE
// -------------------------------------------------------------

model Booking {
  id                  String                 @id @default(uuid())
  customerProfileId   String
  serviceCategory     String
  serviceDescription  String
  isUrgent            Boolean                @default(false)
  scheduledDate       DateTime               @default(now())
  estimatedHours      Float                  @default(2.0)
  estimatedAmount     Float
  finalAmount         Float?
  
  // Location
  addressLine         String
  locality            String?
  city                String
  pincode             String
  customerLatitude    Float
  customerLongitude   Float

  status              BookingStatus          @default(REQUESTED)
  cancellationReason  String?
  cancelledByRole     UserRoleType?

  // Work completion proof
  beforeWorkNotes     String?
  beforeWorkImageUrl  String?
  afterWorkNotes      String?
  afterWorkImageUrl   String?
  workStartedAt       DateTime?
  workCompletedAt     DateTime?
  confirmedAt         DateTime?

  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  customerProfile     CustomerProfile        @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  assignments         BookingAssignment[]
  statusHistory       BookingStatusHistory[]
  attachments         BookingAttachment[]
  locationUpdates     BookingLocation[]
  payment             Payment?
  review              JobReview?
  dispute             JobDispute?
  chatRoom            ChatRoom?

  @@index([customerProfileId])
  @@index([status])
  @@index([city])
}

model BookingAssignment {
  id              String        @id @default(uuid())
  bookingId       String
  workerProfileId String
  assignedAt      DateTime      @default(now())
  respondedAt     DateTime?
  isAccepted      Boolean?      // null = pending, true = accepted, false = rejected

  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@unique([bookingId, workerProfileId])
  @@index([workerProfileId])
}

model BookingStatusHistory {
  id          String        @id @default(uuid())
  bookingId   String
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  notes       String?
  updatedBy   String?
  timestamp   DateTime      @default(now())

  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model BookingLocation {
  id              String   @id @default(uuid())
  bookingId       String
  workerProfileId String
  latitude        Float
  longitude       Float
  accuracyMeters  Float?
  heading         Float?
  speed           Float?
  recordedAt      DateTime @default(now())

  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, recordedAt])
}

model BookingAttachment {
  id          String   @id @default(uuid())
  bookingId   String
  fileUrl     String
  fileType    String   // 'INITIAL_REQUIREMENT', 'BEFORE_WORK', 'AFTER_WORK'
  caption     String?
  createdAt   DateTime @default(now())

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// -------------------------------------------------------------
// CHAT & COMMUNICATIONS
// -------------------------------------------------------------

model ChatRoom {
  id          String        @id @default(uuid())
  bookingId   String        @unique
  createdAt   DateTime      @default(now())

  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
}

model ChatMessage {
  id          String    @id @default(uuid())
  chatRoomId  String
  senderId    String
  message     String
  imageUrl    String?
  isRead      Boolean   @default(false)
  sentAt      DateTime  @default(now())

  chatRoom    ChatRoom  @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender      User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatRoomId])
}

// -------------------------------------------------------------
// PAYMENTS & ESCROW LEDGER
// -------------------------------------------------------------

model Payment {
  id                  String               @id @default(uuid())
  bookingId           String               @unique
  provider            String               @default("RAZORPAY")
  providerOrderId     String?              @unique
  providerPaymentId   String?              @unique
  providerSignature   String?
  amount              Float
  currency            String               @default("INR")
  status              PaymentStatus        @default(INITIATED)
  platformCommission  Float                @default(0.0)
  workerPayoutAmount  Float                @default(0.0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  booking             Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transactions        PaymentTransaction[]
  commissions         PlatformCommission[]
  refunds             Refund[]
  payout              WorkerPayout?

  @@index([status])
  @@index([providerPaymentId])
}

model PaymentTransaction {
  id            String        @id @default(uuid())
  paymentId     String
  transactionRef String       @unique
  amount        Float
  status        PaymentStatus
  rawResponse   String?       // JSON response from provider
  createdAt     DateTime      @default(now())

  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model PlatformCommission {
  id            String   @id @default(uuid())
  paymentId     String
  ratePercent   Float    @default(10.0)
  amount        Float
  recordedAt    DateTime @default(now())

  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model WorkerPayout {
  id              String        @id @default(uuid())
  workerProfileId String
  paymentId       String        @unique
  amount          Float
  upiId           String?
  bankAccount     String?
  ifscCode        String?
  status          String        @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  providerRef     String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())

  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  payment         Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([workerProfileId])
  @@index([status])
}

model WalletLedger {
  id          String   @id @default(uuid())
  userId      String
  entryType   String   // 'CREDIT_PAYOUT', 'DEBIT_FEE', 'REFUND'
  amount      Float
  balanceAfter Float
  description String
  timestamp   DateTime @default(now())

  @@index([userId])
}

model Refund {
  id            String        @id @default(uuid())
  paymentId     String
  amount        Float
  reason        String
  status        PaymentStatus @default(REFUND_PENDING)
  providerRef   String?
  createdAt     DateTime      @default(now())

  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// RATINGS, REVIEWS & DISPUTES
// -------------------------------------------------------------

model JobReview {
  id                String          @id @default(uuid())
  bookingId         String          @unique
  customerProfileId String
  workerProfileId   String
  ratingQuality     Int             @default(5)
  ratingTimeliness  Int             @default(5)
  ratingBehaviour   Int             @default(5)
  ratingOverall     Float           @default(5.0)
  comment           String?
  createdAt         DateTime        @default(now())

  booking           Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerProfile   CustomerProfile @relation("CustomerReviews", fields: [customerProfileId], references: [id], onDelete: Cascade)
  workerProfile     WorkerProfile   @relation("WorkerReviews", fields: [workerProfileId], references: [id], onDelete: Cascade)

  @@index([workerProfileId])
}

model JobDispute {
  id                String          @id @default(uuid())
  bookingId         String          @unique
  customerProfileId String
  reason            DisputeReason
  description       String
  evidenceImages    String?         // Comma-separated or JSON
  status            DisputeStatus   @default(OPEN)
  resolutionNotes   String?
  resolvedByAdminId String?
  resolvedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  booking           Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([status])
}

// -------------------------------------------------------------
// NOTIFICATIONS & AUDIT LOGS
// -------------------------------------------------------------

model Notification {
  id          String   @id @default(uuid())
  userId      String
  title       String
  body        String
  actionUrl   String?
  type        String   @default("INFO") // 'BOOKING', 'PAYMENT', 'TENDER', 'VERIFICATION'
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model NotificationLog {
  id          String   @id @default(uuid())
  channel     String   // 'SMS', 'PUSH', 'WHATSAPP', 'IN_APP'
  recipient   String
  message     String
  status      String   // 'SENT', 'FAILED', 'QUEUED'
  errorReason String?
  timestamp   DateTime @default(now())
}

model SupportTicket {
  id          String   @id @default(uuid())
  userId      String
  subject     String
  message     String
  status      String   @default("OPEN") // 'OPEN', 'IN_PROGRESS', 'RESOLVED'
  priority    String   @default("NORMAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model AdminUser {
  id          String   @id @default(uuid())
  userId      String   @unique
  adminRole   String   @default("OPERATIONS_ADMIN") // SUPER_ADMIN, OPERATIONS_ADMIN, WORKER_VERIFICATION_ADMIN, FINANCE_ADMIN, SUPPORT_ADMIN
  permissions String   // JSON array of strings
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  adminUserId String?
  action      String   // e.g. 'WORKER_VERIFY_APPROVED', 'DISPUTE_REFUND_GRANTED'
  targetType  String   // e.g. 'WorkerProfile', 'Booking', 'Payment'
  targetId    String
  details     String?  // JSON details
  ipAddress   String?
  timestamp   DateTime @default(now())

  user        User?    @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([targetType, targetId])
}
